# ============================================================
# Docker Compose / Airflow settings
# Copy to .env (git-ignored) and replace every placeholder.
# This file contains PLACEHOLDERS ONLY. Never commit real values.
# ============================================================

# --- Airflow security --------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<fernet-key>
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=<random-secret>

# --- Airflow metadata database (local PostgreSQL container) --
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=airflow

# --- Monitoring: Amazon SNS ----------------------------------
# ARN of the alert topic (retail-etl-airflow-alerts in eu-west-2)
AWS_SNS_TOPIC_ARN=arn:aws:sns:eu-west-2:<aws-account-id>:retail-etl-airflow-alerts
# Link included in alert emails (optional)
AIRFLOW_UI_URL=http://localhost:8080

# --- AWS credentials (NO access keys here) -------------------
# Containers reuse your temporary `aws login` session, mounted read-only.
# Default on Windows: %USERPROFILE%\.aws. Set this on macOS/Linux:
# AWS_CONFIG_DIR=/home/<you>/.aws

# --- S3 (optional override) ----------------------------------
# RETAIL_S3_BUCKET=<your-bucket-name>
