# Copy to dashboard/.env (git-ignored) and fill in. Placeholders only.
# Data source: snowflake (default) or local (reads assets/datasets/Transformed_tables)
DASHBOARD_DATA_SOURCE=snowflake

# Account identifier in <orgname>-<accountname> format (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=<username>
SNOWFLAKE_ROLE=<role with SELECT on RETAIL_ETL_DB.RETAIL>
SNOWFLAKE_WAREHOUSE=RETAIL_ETL_WH
SNOWFLAKE_DATABASE=RETAIL_ETL_DB
SNOWFLAKE_SCHEMA=RETAIL

# Choose ONE authentication method (first one set wins):
# 1) Key pair (recommended for services)
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=<passphrase>
# 2) Programmatic access token
SNOWFLAKE_TOKEN=<programmatic-access-token>
# 3) Password
# SNOWFLAKE_PASSWORD=<password>
# 4) Browser SSO
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
